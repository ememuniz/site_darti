// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  MEMBER
  LEADER
  ADMIN
  STUDENT
}

enum JobTitle {
  PRESIDENTE
  VICE_PRESIDENTE
  DIRETOR
  LIDER
  MEMBRO
}

enum Board {
  RECURSOS_HUMANOS
  FINANCEIRO
  COMUNICACAO
  AUTOMAÇÃO_E_ROBOTICA
  SISTEMAS_E_INTELIGENCIA
  INOVAÇÃO_TRANSDISCIPLINAR
}

enum Club {
  DES_WEB_1
  DES_WEB_2
  DES_WEB_3
  HACKATHON
  MIDIA
  ATUALIDADES
  VIS_COMPUTACIONAL_1
  VIS_COMPUTACIONAL_2
  ROBOTICA_1
  ROBOTICA_2
  ROBOTICA_3
  TEC_EDUCACIONAL_1
  TEC_EDUCACIONAL_2
  AEROMODELISMO
  MUSICA
  ESCRITA_CRIATIVA
  DNA_EM_EVIDENCIA
  IDENTIDADE_E_TECNOLOGIA
  PROCESSAMENTO_DE_SINAIS
}

model User {
  id             Int        @id @default(autoincrement())
  email          String     @unique
  password       String
  dateOfBirth    DateTime?
  name           String? 
  socialName     String?
  bio            String?
  linkedin       String?
  github         String?
  role           Role       @default(MEMBER)
  jobTitle       JobTitle?  @default(MEMBRO)
  board          Board[]    
  club           Club[] 
  isActive       Boolean    @default(true)    
  createdAt      DateTime   @default(now())  
}


model Invite {
  id             Int        @id @default(autoincrement())
  token          String     @unique
  used           Boolean    @default(false)
  email          String   
  role           Role       @default(MEMBER)
  usedAt         DateTime?
  isActive       Boolean    @default(true)
  expiresAt      DateTime
  createdAt      DateTime   @default(now())
}